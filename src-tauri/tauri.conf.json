{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "buni.player",
  "version": "0.1.0",
  "identifier": "com.murakami.buni.player",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Buni.player",
        "width": 800,
        "height": 600,
        "minWidth": 800,
        "minHeight": 550,
        "decorations": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$AUDIO/**/*",
            "$APPDATA/**/*"
          ],
          "deny": []
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Buni Player - Reproductor de musica offline y streaming",
    "longDescription": "Buni Player es un reproductor de musica que permite agregar tracks desde YouTube, descargarlos para escuchar offline, enriquecer metadatos con Last.fm y gestionar playlists personalizadas.",
    "copyright": "2026 murakami",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1"
        ]
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "buni"
        ]
      }
    }
  }
}
